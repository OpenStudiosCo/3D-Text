{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "openstudios/three-d-text",
  "version": "0.2.0",
  "title": "3D Text",
  "category": "text",
  "icon": "text",
  "description": "Display text with a 3D effect.",
  "keywords": [
    "3d",
    "text",
    "typography"
  ],
  "textdomain": "openstudios-3d-text",
  "attributes": {
    "content": {
      "type": "string",
      "source": "html",
      "selector": ".wp-block-openstudios-three-d-text__content",
      "default": "",
      "__experimentalRole": "content"
    },
    "level": {
      "type": "number",
      "default": 0
    }
  },
  "supports": {
    "html": false,
    "className": true,
    "anchor": true
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js"
}