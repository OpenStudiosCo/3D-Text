{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "openstudios/three-d-text",
  "version": "0.3.0",
  "title": "3D Text",
  "category": "text",
  "icon": "text",
  "description": "Display text with a 3D effect.",
  "keywords": [ "3d", "text", "typography" ],
  "textdomain": "openstudios-3d-text",
  "attributes": {
    "content": {
      "type": "string",
      "source": "html",
      "selector": ".wp-block-openstudios-three-d-text__content",
      "default": "",
      "__experimentalRole": "content"
    },
    "level": {
      "type": "number",
      "default": 0
    },
    "rotateX": {
      "type": "number",
      "default": -6
    },
    "rotateY": {
      "type": "number",
      "default": 16
    },
    "rotateZ": {
      "type": "number",
      "default": 0
    },
    "offsetX": {
      "type": "number",
      "default": 0
    },
    "offsetY": {
      "type": "number",
      "default": 0
    },
    "sizeScale": {
      "type": "number",
      "default": 1
    },
    "depth": {
      "type": "number",
      "default": 0.08
    },
    "bevel": {
      "type": "number",
      "default": 0
    },
    "fontFamily": {
      "type": "string",
      "default": "helvetiker"
    },
    "fontWeight": {
      "type": "string",
      "default": "regular"
    },
    "textColor": {
      "type": "string",
      "default": ""
    },
    "shiny": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "html": false,
    "className": true,
    "anchor": true
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js"
}
